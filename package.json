{
  "name": "ring-vision-mcp",
  "version": "1.0.0",
  "description": "Open-source Model Context Protocol (MCP) server for Ring cameras and doorbells, built on the official 2026 Amazon Vision Partner API",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "ring-vision-mcp": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "build": "tsup src/index.ts --format esm --dts --clean",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "ring",
    "amazon-vision",
    "webrtc",
    "whep",
    "iot",
    "camera"
  ],
  "author": "Devashish Soni",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^20.10.6",
    "tsup": "^8.5.1",
    "tsx": "^4.23.13",
    "typescript": "^5.3.3"
  }
}
